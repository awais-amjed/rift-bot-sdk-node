{
  "name": "@joinrift/bot-sdk",
  "version": "0.1.2",
  "license": "Apache-2.0",
  "description": "Write a Rift bot. Auth, commands, replies, panels and voice against a self-hosted server.",
  "keywords": [
    "rift",
    "bot",
    "sdk",
    "chat",
    "voice",
    "end-to-end-encryption"
  ],
  "homepage": "https://joinrift.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awais-amjed/rift-bot-sdk-node.git"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "WIRE.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p .",
    "prepack": "npm run build",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "@livekit/rtc-node": ">=0.13.0"
  },
  "peerDependenciesMeta": {
    "@livekit/rtc-node": {
      "optional": true
    }
  },
  "devDependencies": {
    "@livekit/rtc-node": "^1.1.0",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
